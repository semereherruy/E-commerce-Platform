# Django Security
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-key
ALLOWED_HOSTS=localhost,127.0.0.1
DOMAIN=localhost:3000

# Database (Render PostgreSQL in production)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://client:market123@localhost:5432/ecommerce_db

# Initial superuser (used by `create_admin_if_not_exists` during Render deploys)
# Set these in the Render dashboard Environment tab — never commit real values.
# After the first successful deploy you may remove DJANGO_SUPERUSER_PASSWORD from Render.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-a-strong-password

# Admin contact (Django ADMINS setting for error notification emails)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com

# Email (SMTP)
EMAIL_HOST=localhost
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=admin@ecommerce.com

# Redis & Celery
REDIS_URL=redis://127.0.0.1:6379/2
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

# Logging
DJANGO_LOG_LEVEL=INFO

# Cloudinary (media storage in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production-only (set in Render)
DJANGO_SETTINGS_MODULE=storefront.settings.production
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
# SECURE_SSL_REDIRECT=True
